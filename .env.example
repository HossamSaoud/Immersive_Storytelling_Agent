# Copy to .env and fill in. Never commit .env.

# 1) Pick a provider: anthropic | openai | groq | huggingface | ollama   (ollama needs no key)
LLM_PROVIDER=openai

# 2) Put the key for that provider (only the one you use is needed)
OPENAI_API_KEY=your-key-here
# GROQ_API_KEY=
# CLAUDE_API_KEY=
# ANTHROPIC_WORKSPACE_ID=   # only if your key is not scoped to a workspace
# HF_API_KEY=

# 3) Optional: choose models. STORY_MODEL applies to every agent; the others override one agent.
# STORY_MODEL=
# PLANNER_MODEL=
# NARRATOR_MODEL=
# CRITIC_MODEL=          # e.g. a stronger model than the narrator
# DIRECTOR_MODEL=
# SAFETY_MODEL=
# LLM_BASE_URL=          # any other OpenAI-compatible server (then set OPENAI_API_KEY)

# 4) Optional: story shape and quality gate (defaults shown)
# MAX_SCENES=5
# MAX_REVISIONS=2        # rewrites the critic may demand per scene
# CRITIC_MIN_SCORE=8     # 1-10 score a scene needs before the player sees it
